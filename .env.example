CHORDLAB_USERNAME=suika
CHORDLAB_PASSWORD=replace-with-a-long-password
CHORDLAB_SECRET=replace-with-at-least-32-random-characters
CHORDLAB_SECURE_COOKIE=true
CHORDLAB_MAX_UPLOAD_MB=200
CHORDLAB_MAX_DURATION_MIN=20
CHORDLAB_JOBS_DIR=/mnt/sdb/chordlab/jobs
CHORDLAB_STORAGE_MOUNT=/mnt/sdb
CHORDLAB_ANALYSIS_WORKERS=1
CHORDLAB_MAX_ACTIVE_PER_USER=2
CHORDLAB_DAILY_JOB_LIMIT=5
CHORDLAB_SESSION_DAYS=7
CHORDLAB_APP_HOSTS=chord.suika.page,localhost,127.0.0.1
CHORDLAB_WHISPER_MODEL=small
CHORDLAB_MEDIA_HOSTS=youtube.com,youtu.be,music.youtube.com,soundcloud.com,bandcamp.com,bilibili.com,vimeo.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_FILE=/absolute/path/to/client_secret.json
GOOGLE_REDIRECT_URI=https://chord.suika.page/auth/google/callback
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ADMIN_EMAILS=admin@example.com
