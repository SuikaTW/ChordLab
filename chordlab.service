[Unit]
Description=ChordLab private music analysis service
After=network-online.target
Wants=network-online.target
ConditionPathIsMountPoint=/mnt/sdb
ConditionPathIsMountPoint=/mnt/sdb

[Service]
Type=simple
WorkingDirectory=/home/suika/chordlab
EnvironmentFile=/home/suika/chordlab/.env
ExecStart=/home/suika/chordlab/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8788 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
