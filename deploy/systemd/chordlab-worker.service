[Unit]
Description=ChordLab durable analysis worker
After=network-online.target
Wants=network-online.target
ConditionPathIsMountPoint=/mnt/sdb

[Service]
Type=simple
WorkingDirectory=/home/suika/chordlab
EnvironmentFile=/home/suika/chordlab/.env
Environment=CHORDLAB_EMBEDDED_WORKER=false
ExecStart=/home/suika/chordlab/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
